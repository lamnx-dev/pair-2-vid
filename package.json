{
  "name": "pair-2-vid",
  "version": "1.3.0",
  "description": "CLI tool that batches image+audio (or image+text TTS) pairs into MP4 videos",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "p2v": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsx tests/run-tests.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "commander": "^13.1.0",
    "execa": "^9.6.0",
    "onnxruntime-node": "^1.27.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "piper-phonemize": "^1.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
