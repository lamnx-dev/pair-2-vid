{
  "name": "pair-2-vid",
  "version": "1.3.0",
  "description": "CLI tool for creating MP4 videos from images and audio or TTS text, with background compositing, intro overlays, and ONNX TTS support",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "p2v": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "tsx tests/run-tests.ts",
    "test:thumb": "tsx tests/test-thumb.ts",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "commander": "^13.1.0",
    "execa": "^9.6.0",
    "onnxruntime-node": "^1.27.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "piper-phonemize": "^1.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.77.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
